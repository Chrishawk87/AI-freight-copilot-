// AI Freight Co-Pilot — data model
// PostgreSQL (Railway in production; use the Railway Postgres URL locally too).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("owner_operator") // owner_operator | dispatcher | fleet_manager
  createdAt    DateTime  @default(now())

  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  carrierId String?

  bids      Bid[]
  bookings  Booking[]
  documents Document[]
}

model Carrier {
  id                String   @id @default(cuid())
  companyName       String
  contactEmail      String   @default("") // company email — the "From"/reply-to for document packages
  // Per-carrier outbound email — client connects their OWN provider (Gmail,
  // Outlook, Yahoo, any SMTP). smtpPass is stored ENCRYPTED, never returned.
  smtpHost          String   @default("")
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false) // true = implicit TLS (port 465)
  smtpUser          String   @default("") // usually the same as contactEmail
  smtpPass          String   @default("") // encrypted app password / SMTP password
  // OAuth "Connect Gmail / Outlook" — the scalable way to send from the
  // carrier's OWN address with one click (no app passwords). Refresh token is
  // stored ENCRYPTED; access tokens are minted on demand and never stored.
  emailOauthProvider String  @default("") // "google" | "microsoft"
  emailOauthEmail    String  @default("") // the connected mailbox address
  emailOauthRefresh  String  @default("") // encrypted OAuth refresh token
  dotNumber         String   @default("")
  mcNumber          String   @default("")
  insuranceProvider String   @default("")
  insuranceExpiry   String   @default("")
  w9OnFile          Boolean  @default(false)
  serviceAreas      String   @default("[]") // JSON array of state codes
  mpg               Float    @default(6.5)
  fixedCostPerMile  Float    @default(0.72)
  createdAt         DateTime @default(now())

  users     User[]
  drivers   Driver[]
  equipment Equipment[]
  bookings  Booking[]
  documents Document[]
}

model Driver {
  id        String  @id @default(cuid())
  name      String
  cdlClass  String  @default("Class A")
  status    String  @default("Active")
  carrier   Carrier @relation(fields: [carrierId], references: [id])
  carrierId String
}

model Equipment {
  id        String  @id @default(cuid())
  type      String
  unit      String
  year      Int
  carrier   Carrier @relation(fields: [carrierId], references: [id])
  carrierId String
}

model Load {
  id            String   @id @default(cuid())
  externalId    String   @unique // provider load id e.g. L-4821
  equipment     String
  originCity    String
  originState   String
  destCity      String
  destState     String
  miles         Int
  deadheadMiles Int
  rate          Float
  weightLbs     Int
  broker        String
  brokerRating  Float
  pickupDate    String
  source        String // DAT, Truckstop, Uber Freight...
  demandIndex   Int
  reloadIndex   Int
  isReloadPool  Boolean  @default(false) // reload marketplace vs main board
  active        Boolean  @default(true) // false once the board no longer lists it
  lastSeenAt    DateTime @default(now()) // last sync that saw this load on the board
  createdAt     DateTime @default(now())

  bids      Bid[]
  bookings  Booking[]
  documents Document[]

  @@index([active])
}

model Bid {
  id        String   @id @default(cuid())
  amount    Float
  message   String   @default("")
  status    String   @default("submitted") // submitted | countered | accepted | rejected
  createdAt DateTime @default(now())

  load   Load   @relation(fields: [loadId], references: [id])
  loadId String
  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Booking {
  id        String   @id @default(cuid())
  status    String   @default("booked") // booked | in_transit | delivered | canceled
  bookedAt  DateTime @default(now())

  load      Load     @relation(fields: [loadId], references: [id])
  loadId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  carrier   Carrier  @relation(fields: [carrierId], references: [id])
  carrierId String

  documents Document[]
}

// A scanned freight document (Bill of Lading, Proof of Delivery, lumper or fuel
// receipt). The driver photographs it at the dock; a dedicated OCR provider (or
// the simulated fallback) extracts the fields, we check it's signed/complete,
// auto-match it to the booked load, and stage the invoice — all on the spot.
model Document {
  id     String @id @default(cuid())
  type   String @default("BOL") // BOL | POD | LUMPER | FUEL | OTHER
  status String @default("captured") // captured | needs_review | complete

  imageData String? // base64 data URL of the scan (demo store; swap for blob storage later)

  // Extracted fields
  bolNumber        String  @default("")
  proNumber        String  @default("")
  shipper          String  @default("")
  consignee        String  @default("")
  poNumber         String  @default("")
  pieceCount       Int?
  weightLbs        Int?
  shipDate         String  @default("")
  deliveryDate     String  @default("")
  signaturePresent Boolean @default(false)
  signedBy         String  @default("")

  // Completeness / exceptions / provenance
  missingFields String @default("[]") // JSON array of field names still missing
  extractedRaw  String @default("{}") // raw OCR result JSON
  ocrProvider   String @default("simulated") // which engine produced this
  confidence    Int    @default(0) // 0-100 overall extraction confidence

  // Invoice staging
  invoiceAmount Float?
  invoiceStatus String @default("none") // none | staged | sent

  // Rate Confirmation ("Rate Con") — the broker's binding assignment that
  // STARTS a haul (vs. a BOL/POD which prove one at the dock). Parsed on intake
  // by OCR + Claude; the driver reviews and confirms, which spins up a real
  // Load + Booking. Broker-agnostic: no per-broker integration needed.
  rateConNumber       String  @default("")
  lineHaulRate        Float?
  fuelSurcharge       Float?
  accessorials        String  @default("[]") // JSON: [{ name, amount }] (lumper, detention, tarp…)
  totalRate           Float?
  originCity          String  @default("")
  originState         String  @default("")
  pickupAddress       String  @default("")
  pickupAppt          String  @default("") // appointment time / window as printed
  destCity            String  @default("")
  destState           String  @default("")
  deliveryAddress     String  @default("")
  deliveryAppt        String  @default("")
  commodity           String  @default("")
  equipmentType       String  @default("") // Van, Reefer, Flatbed…
  brokerName          String  @default("")
  brokerContactName   String  @default("")
  brokerPhone         String  @default("")
  brokerEmail         String  @default("")
  referenceNumber     String  @default("") // broker load/reference # (distinct from PO)
  specialInstructions String  @default("")
  loadStaged          Boolean @default(false) // parsed, awaiting driver confirmation
  loadConfirmed       Boolean @default(false) // driver confirmed → Load+Booking created

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?
  load      Load?    @relation(fields: [loadId], references: [id])
  loadId    String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  carrierId String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per billable AI event (an OCR scan or a Co-Pilot LLM reply). We meter
// per-carrier so the company can see who's consuming the shared provider
// accounts and cap runaway usage. Events where the driver supplied their OWN key
// (BYOK) or that fell back to the free simulated engine are recorded with
// billable=false so they don't count against the company's cost or caps.
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String // ocr_scan | copilot_llm
  provider  String   @default("") // mindee | anthropic | simulated | byok
  billable  Boolean  @default(true) // true = cost lands on the company's shared account
  units     Int      @default(1) // scans/calls (or tokens later)
  userId    String
  carrierId String?
  createdAt DateTime @default(now())

  @@index([carrierId, createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

// ── The Co-Pilot's persistent memory ────────────────────────────────────────
// Two layers, on purpose.
//
// SURFACE (CarrierMemory): what THIS carrier has taught the brain — home base,
// preferred lanes, real cost per mile, brokers they trust, "never route me
// through Chicago". Per-tenant, driver-editable, read on every Co-Pilot call so
// answers are personal. Grows over time as the driver adds facts.
//
// SUBSURFACE (KnowledgeEntry): the shared freight knowledge base every carrier
// rides on — truck stops, load & trailer types, document types, what brokers
// and shippers require, roads/routes/regs, and a bank of common driver
// questions with canonical answers. Seeded once (scope="global"), read by
// everyone, and answerable with NO live Claude call. Drivers can contribute
// their own entries (scope=carrierId) that layer on top.

model CarrierMemory {
  id        String   @id @default(cuid())
  carrierId String
  category  String   @default("general") // preference | lane | cost | broker | equipment | contact | general
  key       String // short label, e.g. "Home base"
  value     String // the fact, e.g. "Dallas, TX — prefer loads within 500 mi"
  source    String   @default("driver") // driver | copilot
  pinned    Boolean  @default(false) // always inject into the brain, even when space is tight
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId, category])
}

model KnowledgeEntry {
  id          String   @id @default(cuid())
  scope       String   @default("global") // "global" (shared) | a carrierId (that carrier's own addition)
  category    String // truck-stops | load-types | trailers | documents | brokers | shippers | routes | regulations | qa
  subcategory String   @default("")
  topic       String // title, or the question for a qa entry
  content     String // the body / the answer
  keywords    String   @default("") // comma-separated, for cheap offline matching
  source      String   @default("seed") // seed | driver | copilot
  seedKey     String? // stable id for seed rows so re-seeding is idempotent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([seedKey])
  @@index([scope, category])
  @@index([category, subcategory])
}

model FuelStation {
  id         String  @id @default(cuid())
  name       String
  city       String
  state      String
  price      Float
  distanceMi Int
  onRoute    Boolean
  network    String
  latitude   Float?
  longitude  Float?
  exit       String?
  address    String?
}

// ── Truck Map & Fuel Intelligence module (Phase 1) ──────────────────────────
// Unified point-of-interest store for the Cesium map: fuel, truck parking, rest
// areas, weigh stations, repair, service areas. Ingested from OpenStreetMap
// (Overpass) into our own DB so the API never hits Overpass on the hot path.
//
// SCALE NOTE: for production nearest-neighbor / along-route queries at fleet
// scale, a follow-up SQL migration adds PostGIS (geometry(Point,4326) + GiST
// index) so we can use the `<->` KNN operator and `ST_DWithin`. Phase 1 queries
// by lat/lon bounding box + haversine sort, which runs on plain Postgres with
// the (state, category) and lat/lon indexes below.

enum PoiCategory {
  fuel
  parking
  rest_area
  weigh_station
  repair
  services
}

model Poi {
  id            String       @id @default(cuid())
  source        String // "osm" | "commercial" | "user"
  sourceId      String // e.g. osm node/way id — unique per source
  category      PoiCategory
  name          String
  brand         String? // normalized network (Love's, Pilot, TA…)
  lat           Float
  lon           Float
  address       String?
  city          String?
  state         String?
  hoursRaw      String? // OSM opening_hours (may be null)
  hgv           Boolean      @default(false) // truck-accessible
  diesel        Boolean      @default(false)
  defAvailable  Boolean?
  parkingSpaces Int?
  active        Boolean      @default(true) // false = not seen in last sweep (soft-remove)
  lastSeenAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  amenities PoiAmenity[]
  prices    FuelPrice[]

  @@unique([source, sourceId])
  @@index([category, state])
  @@index([category, active])
  @@index([lat, lon])
}

model PoiAmenity {
  id    String @id @default(cuid())
  poiId String
  poi   Poi    @relation(fields: [poiId], references: [id], onDelete: Cascade)
  key   String // showers | scales | def | restaurant | wifi | hgv_lanes …
  value String @default("") // free-form (e.g. count of showers)

  @@index([poiId])
}

model FuelPrice {
  id         String   @id @default(cuid())
  poiId      String
  poi        Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  fuelType   String   @default("diesel") // diesel | def
  price      Float // retail $/gal
  source     String // "eia_region" | "scrape" | "user" | "commercial"
  confidence Float    @default(0.5) // 0..1, decays with age
  reportedAt DateTime @default(now())

  @@index([poiId, fuelType, reportedAt])
}

// ── Vehicle profile (Phase 2) ───────────────────────────────────────────────
// Truck dimensions drive truck-LEGAL routing (§2.5). A route that's illegal for
// an 80,000 lb rig is a bug, not a rounding error — these values are passed to
// the OpenRouteService `driving-hgv` profile as height/width/length/weight/
// axleload/hazmat restrictions. Scoped per carrier for multi-tenant isolation.

model Truck {
  id          String   @id @default(cuid())
  carrierId   String
  label       String // "Blue Pete 379", "Unit 12"…
  heightIn    Int      @default(162) // 13'6" default legal max
  widthIn     Int      @default(102) // 8'6"
  lengthIn    Int      @default(636) // 53' trailer + tractor
  weightLbs   Int      @default(80000)
  axles       Int      @default(5)
  hazmatClass String? // null = non-hazmat
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([carrierId])
}
