# ---- Backend (NestJS API) environment ----
# PostgreSQL connection string.
#  - On Railway: reference the Postgres service var, e.g. ${{Postgres.DATABASE_URL}}
#  - Locally: paste Railway's PUBLIC Postgres URL here (Data tab -> Connect -> Public)
DATABASE_URL="postgresql://user:pass@host:5432/aifreight?schema=public"

# Long random secret. Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Railway injects PORT automatically; this is only the local fallback.
PORT=4000

# Comma-separated allowed frontend origins (no trailing slash).
# In production set to your deployed frontend URL, e.g.
# https://ai-freight-frontend.up.railway.app
CORS_ORIGIN="http://localhost:3000"

# ---- Load board / map integrations (leave blank to use simulated feeds) ----
# Each key activates that board's live-pull provider. All are partner/paid APIs
# (no free self-serve API exists for these boards today):
#  - DAT: developer API, paid setup + subscription (dat.com/api-integration)
#  - 123Loadboard: partner API (partner-integrations@123loadboard.com)
#  - Truckstop: partner API (approval required)
DAT_API_KEY=""
LOADBOARD123_API_KEY=""
TRUCKSTOP_API_KEY=""
UBER_FREIGHT_API_KEY=""
MAPBOX_TOKEN=""

# ---- Document OCR (BOL / POD scanning) ----
# Powers instant field extraction from scanned freight docs. Leave blank and the
# app uses a simulated extraction so the scan → review → invoice flow still works.
# A driver can also paste their own key in the Plugin Engine (per-device).
#  - Default provider is Mindee's Bill of Lading API (mindee.com).
OCR_PROVIDER="mindee"
OCR_API_KEY=""

# ---- Co-Pilot conversational brain ----
# The COMPANY key. Set this and every subscriber gets the Claude Co-Pilot for
# free — no per-driver setup. Leave blank and the app uses its built-in replies
# (no cost). A power user can still paste their OWN key in the Plugin Engine to
# bill their own account instead.
ANTHROPIC_API_KEY=""
# Optional: override the model. Defaults to a fast Claude model.
ANTHROPIC_MODEL=""

# ---- Per-tenant usage caps (protect the shared provider accounts) ----
# Monthly cap of COMPANY-paid AI calls per carrier (0 or blank = unlimited).
# Over the cap, OCR falls back to the free simulated engine and the Co-Pilot
# falls back to its built-in brain — so one heavy user can't run up the shared
# Mindee / Anthropic bill. Calls a driver covers with their OWN key don't count.
USAGE_OCR_MONTHLY_CAP=""
USAGE_LLM_MONTHLY_CAP=""

# ---- Outbound email (send document packages from the app) ----
# Same server-key model: set these once on the backend and EVERY subscriber can
# email a job's combined PDF straight from the Documents tab — nothing to plug
# in per driver. Leave blank and the Email button reports "not set up yet" while
# the rest of Documents (scan, package download) keeps working.
# Works with any SMTP provider (SendGrid, Mailgun, Postmark, Amazon SES, Gmail…).
#   SMTP_HOST   e.g. smtp.sendgrid.net
#   SMTP_PORT   587 (STARTTLS) or 465 (implicit TLS)
#   SMTP_USER   smtp username / API key user (e.g. "apikey" for SendGrid)
#   SMTP_PASS   smtp password / API key
#   MAIL_FROM   the visible sender, e.g. "AI Freight Co-Pilot <docs@yourco.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
